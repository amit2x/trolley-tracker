# Copy this file to .env and fill in real values.
# .env itself is gitignored — only this template should ever be committed.

# Database
DB_NAME=trolley.db

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=airport/trolleys

# Default Admin (CHANGE THESE before deploying anywhere beyond localhost)
#(Loaded only if no admin user exists in the database, if exists then it will be ignored and not loaded)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_ROLE=admin

# Streamlit (Just for noting purpose, not loaded by Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
